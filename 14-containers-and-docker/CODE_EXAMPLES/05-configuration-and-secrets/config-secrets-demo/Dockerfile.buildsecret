# FIXED for build-time secrets: a BuildKit secret mount. The token exists only while this one RUN executes;
# it is never written to a layer, the history, or the image config.
FROM eclipse-temurin:21-jre
WORKDIR /app
RUN --mount=type=secret,id=npm_token \
    test -s /run/secrets/npm_token && echo "pretend this downloads something with the token" > /dev/null
COPY target/app.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
